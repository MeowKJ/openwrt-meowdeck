#!/bin/sh
set -eu

CONFIG=/etc/meowdeck/update.conf
# shellcheck source=/dev/null
[ -r "$CONFIG" ] && . "$CONFIG"

REPO=${REPO:-MeowKJ/openwrt-meowdeck}
CHANNEL=${CHANNEL:-stable}
CURL_CONNECT_TIMEOUT=${CURL_CONNECT_TIMEOUT:-15}
CURL_MAX_TIME=${CURL_MAX_TIME:-300}
API=https://api.github.com/repos/$REPO/releases

case "$(uname -m)" in
	aarch64) ARCH=arm64 ;;
	x86_64) ARCH=amd64 ;;
	armv7l) ARCH=armv7 ;;
	mipsel) ARCH=mipsle ;;
	mips) ARCH=mips ;;
	*) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

if [ "$CHANNEL" = edge ]; then
	RELEASE_URL=$API/tags/edge
else
	RELEASE_URL=$API/latest
fi

WORKDIR=$(mktemp -d /tmp/meowdeck-update.XXXXXX)
SUCCESS=0
MUTATING=0
WAS_RUNNING=0

fetch() {
	curl -fsSL \
		--connect-timeout "$CURL_CONNECT_TIMEOUT" \
		--max-time "$CURL_MAX_TIME" \
		"$1" -o "$2"
}

backup_file() {
	target=$1
	name=$2
	if [ -e "$target" ]; then
		cp -p "$target" "$WORKDIR/$name.previous"
		: >"$WORKDIR/$name.existed"
	fi
}

restore_file() {
	target=$1
	name=$2
	if [ -f "$WORKDIR/$name.existed" ]; then
		cp -p "$WORKDIR/$name.previous" "$target"
	else
		rm -f "$target"
	fi
}

finalize() {
	status=$?
	trap - EXIT HUP INT TERM
	if [ "$SUCCESS" -ne 1 ] && [ "$MUTATING" -eq 1 ]; then
		set +e
		echo "update failed; rolling back" >&2
		/etc/init.d/meowdeck stop >/dev/null 2>&1
		restore_file /usr/bin/meowdeck meowdeck.bin
		restore_file /etc/init.d/meowdeck meowdeck.init
		restore_file /usr/bin/meowdeck-update meowdeck-update
		restore_file /usr/bin/meowdeck-configure meowdeck-configure
		restore_file /usr/share/meowdeck/nginx.conf.template nginx.template
		restore_file /usr/share/meowdeck/dnsmasq.uci.template dnsmasq.template
		restore_file /etc/nginx/conf.d/meowdeck.conf nginx.conf
		uci import dhcp <"$WORKDIR/dhcp.uci"
		uci commit dhcp
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		nginx -s reload >/dev/null 2>&1
		if [ "$WAS_RUNNING" -eq 1 ]; then
			/etc/init.d/meowdeck start >/dev/null 2>&1
		fi
	fi
	rm -rf "$WORKDIR"
	exit "$status"
}
trap finalize EXIT HUP INT TERM

fetch "$RELEASE_URL" "$WORKDIR/release.json"
VERSION=$(jq -r '.tag_name' "$WORKDIR/release.json")
ASSET=meowdeck-linux-$ARCH.tar.gz
ASSET_URL=$(jq -r --arg name "$ASSET" '.assets[] | select(.name == $name) | .browser_download_url' "$WORKDIR/release.json")
SUM_URL=$(jq -r --arg name "$ASSET.sha256" '.assets[] | select(.name == $name) | .browser_download_url' "$WORKDIR/release.json")

if [ -z "$ASSET_URL" ] || [ "$ASSET_URL" = null ]; then
	echo "release asset not found: $ASSET" >&2
	exit 1
fi
if [ -z "$SUM_URL" ] || [ "$SUM_URL" = null ]; then
	echo "checksum not found: $ASSET.sha256" >&2
	exit 1
fi

fetch "$ASSET_URL" "$WORKDIR/$ASSET"
fetch "$SUM_URL" "$WORKDIR/$ASSET.sha256"
(
	cd "$WORKDIR"
	sha256sum -c "$ASSET.sha256"
	tar -xzf "$ASSET"
)

[ -x /etc/init.d/meowdeck ] && /etc/init.d/meowdeck running >/dev/null 2>&1 && WAS_RUNNING=1
backup_file /usr/bin/meowdeck meowdeck.bin
backup_file /etc/init.d/meowdeck meowdeck.init
backup_file /usr/bin/meowdeck-update meowdeck-update
backup_file /usr/bin/meowdeck-configure meowdeck-configure
backup_file /usr/share/meowdeck/nginx.conf.template nginx.template
backup_file /usr/share/meowdeck/dnsmasq.uci.template dnsmasq.template
backup_file /etc/nginx/conf.d/meowdeck.conf nginx.conf
uci export dhcp >"$WORKDIR/dhcp.uci"
MUTATING=1

/etc/init.d/meowdeck stop || true
mkdir -p /usr/share/meowdeck
cp "$WORKDIR/meowdeck" /usr/bin/meowdeck
chmod 0755 /usr/bin/meowdeck
cp "$WORKDIR/meowdeck.init" /etc/init.d/meowdeck
chmod 0755 /etc/init.d/meowdeck
cp "$WORKDIR/meowdeck-update" /usr/bin/meowdeck-update
chmod 0755 /usr/bin/meowdeck-update
cp "$WORKDIR/meowdeck-configure" /usr/bin/meowdeck-configure
chmod 0755 /usr/bin/meowdeck-configure
cp "$WORKDIR/meowdeck.nginx.conf" /usr/share/meowdeck/nginx.conf.template
cp "$WORKDIR/meowdeck.dnsmasq.uci" /usr/share/meowdeck/dnsmasq.uci.template

/usr/bin/meowdeck-configure --no-restart
/etc/init.d/meowdeck start

healthy=0
for _ in 1 2 3 4 5; do
	if curl -fsS http://127.0.0.1:9080/healthz >/dev/null 2>&1; then
		healthy=1
		break
	fi
	sleep 1
done
[ "$healthy" -eq 1 ] || { echo "updated service failed health check" >&2; exit 1; }

SUCCESS=1
echo "MeowDeck updated to $VERSION ($CHANNEL)"
