#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=96
# shellcheck disable=SC2034
STOP=9

start_service() {
	procd_open_instance
	# The variables below are intentionally expanded by the child shell.
	# shellcheck disable=SC2016
	procd_set_param command /bin/sh -c '
		sleep 120
		while true; do
			/usr/bin/meowdeck-update || logger -t meowdeck-updater "automatic update check failed"
			. /etc/meowdeck/update.conf 2>/dev/null || true
			if [ "${CHANNEL:-stable}" = edge ]; then interval=900; else interval=21600; fi
			jitter=$(($$ % 301))
			sleep $((interval + jitter))
		done
	'
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
