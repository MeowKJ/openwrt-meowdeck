{
  "listen": "127.0.0.1:9080",
  "hostname": "meow.lan",
  "intervalSeconds": 30,
  "timeoutSeconds": 4,
  "historySize": 120,
  "services": [
    {
      "id": "router",
      "slug": "router",
      "name": "GL.iNet 管理后台",
